# Database Configuration
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/limo

# Redis (optional)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Google Gemini AI API Keys
GEMINI_KEY_1=your_gemini_api_key_here
GEMINI_KEY_2=your_optional_gemini_api_key_2_here
GEMINI_KEY_3=your_optional_gemini_api_key_3_here

# Nvidia NIM API Keys
NVIDIA_KEY_1=your_nvidia_nim_key_1_here
NVIDIA_KEY_2=your_nvidia_nim_key_2_here
NVIDIA_KEY_3=your_nvidia_nim_key_3_here
NVIDIA_KEY_4=your_nvidia_nim_key_4_here

# App & Security
APP_NAME=Limo AI Workspace
CORS_ORIGINS=*

# Google OAuth 2.0 (Phase D9.5 - Hosted Web Demo)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5190/auth/callback

# Pexels Image API Keys
PEXELS_KEY_1=your_pexels_key_1_here
PEXELS_KEY_2=your_pexels_key_2_here
PEXELS_KEY_3=your_pexels_key_3_here

# Pixabay Image API Keys
PIXABAY_KEY_1=your_pixabay_key_1_here
PIXABAY_KEY_2=your_pixabay_key_2_here
PIXABAY_KEY_3=your_pixabay_key_3_here
