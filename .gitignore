# ==============================================================================
# Limo Repository .gitignore
# ==============================================================================

# 1. Environment & Credentials (NEVER commit secrets, tokens, or private keys)
.env
.env.*
*.env
!.env.example
credentials/
credentials/**
!credentials/*.example
client_secret_*.json
*.pem
*.key
*.cert
*.crt
*.pfx

# 2. Local Databases & Sandboxed Data Storage
*.db
*.db-journal
*.sqlite
*.sqlite3
data/
**/data/**
backend/data/**

# 3. Tests, Test Runners & Test Artifacts (Per Push Policy)
tests/
tests/**
**/tests/
**/tests/**
backend/tests/
backend/tests/**
frontend/tests/
frontend/tests/**
test-artifacts/
**/test-artifacts/**
test_artifacts/
**/test_artifacts/**
**/__tests__/**
*.test.ts
*.test.tsx
*.test.js
*.test.py
*_test.py
test_*.py
verify_*.py
generate_*.py
/scripts/
/scripts/**
.pytest_cache/
**/.pytest_cache/**
coverage/
**/coverage/**
.nyc_output/

# 4. Documentation & Specifications (Per Push Policy)
docs/
docs/**
**/docs/
**/docs/**
prismo-limo-handoff/
prismo-limo-handoff/**
**/prismo-limo-handoff/**

